<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package of عرض (packaging/windows/msix/make-msix.ps1 fills @VERSION@).
     Identity comes from Partner Center (Product management › Product identity); the Store signs it.
     One application only: the Store refuses a second, hidden one (such as a command-line alias) as
     a "headless app". ard-cli.exe still ships in the package for MCP users who call it by path. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="NasserAlqahtani.620741EE7250E"
    Publisher="CN=AF2BB125-FF7A-4337-932D-42917A905572"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>عرض</DisplayName>
    <PublisherDisplayName>Nasser Alqahtani</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>برنامج عروض تقديمية عربي</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ar-SA" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Ard" Executable="Ard.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="عرض"
        Description="برنامج عروض تقديمية عربي"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="ard.presentation">
            <uap:DisplayName>عرض تقديمي</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.pptx</uap:FileType>
              <uap:FileType>.ppsx</uap:FileType>
              <uap:FileType>.potx</uap:FileType>
              <uap:FileType>.deckcraft</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
